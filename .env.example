# Postgres
POSTGRES_USER=buildgate
POSTGRES_PASSWORD=buildgate
POSTGRES_DB=buildgate
DATABASE_URL=postgresql+psycopg://buildgate:buildgate@db:5432/buildgate
TEST_DATABASE_URL=postgresql+psycopg://buildgate:buildgate@db:5432/buildgate_test

# Ollama (runs on the host machine, not in a container)
OLLAMA_HOST=http://host.docker.internal:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
SENTENCE_TRANSFORMERS_MODEL=all-mpnet-base-v2

# Uploads
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.md,.txt
STORAGE_DIR=/data/uploads

# Outbound HTTP allowlist (comma-separated hostnames)
OUTBOUND_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,ollama

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
